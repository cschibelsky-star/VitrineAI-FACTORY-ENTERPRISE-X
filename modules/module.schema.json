{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrineaipro.com.br/schemas/module.schema.json",
  "title": "Vitrine IA Reusable Module Manifest",
  "type": "object",
  "required": ["key", "name", "category", "version", "status", "description", "requires", "provides"],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 3},
    "category": {"enum": ["core", "gestao", "comercial", "financeiro", "operacao", "comunicacao", "conteudo", "ia"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["planned", "prototype", "development", "homologation", "production", "legacy"]},
    "description": {"type": "string", "minLength": 10},
    "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provides": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "commercial": {
      "type": "object",
      "properties": {
        "sellable": {"type": "boolean"},
        "standalone": {"type": "boolean"},
        "audience": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "properties": {
        "entities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
