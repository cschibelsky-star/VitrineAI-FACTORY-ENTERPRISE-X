{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrineaipro.com.br/schemas/product.schema.json",
  "title": "Vitrine AI Product Manifest",
  "type": "object",
  "required": ["key", "name", "version", "status", "runtime", "health", "core"],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["prototype", "development", "homologation", "production", "legacy"]},
    "runtime": {
      "type": "object",
      "required": ["type", "database"],
      "properties": {
        "type": {"enum": ["php", "laravel", "node", "static"]},
        "database": {"enum": ["none", "sqlite", "mysql", "postgresql"]},
        "containerized": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "expected_status": {"type": "integer", "minimum": 100, "maximum": 599}
      },
      "additionalProperties": false
    },
    "core": {
      "type": "object",
      "required": ["authentication", "licensing", "commercial_leads"],
      "properties": {
        "authentication": {"enum": ["local", "core", "none"]},
        "licensing": {"enum": ["local", "core", "none"]},
        "commercial_leads": {"enum": ["local", "core", "hybrid", "none"]}
      },
      "additionalProperties": false
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
